{
  "name": "aissa-mono",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "build:ui": "turbo run build -F @repo/ui",
    "dev": "turbo run dev",
    "dev:public-local": "bash ./scripts/dev-public-local.sh",
    "lint": "turbo run lint",
    "check-types": "turbo run check-types",
    "test": "turbo run test",
    "test:unit": "turbo run test:unit",
    "test:int": "turbo run test:int",
    "test:e2e": "turbo run test:e2e",
    "precommit": "bash ./scripts/precommit.sh",
    "prepush": "bash ./scripts/prepush.sh",
    "ci": "pnpm check-types && pnpm lint && pnpm test",
    "prepare": "husky",
    "format": "prettier --write \"**/*.{ts,tsx,md}\""
  },
  "devDependencies": {
    "husky": "^9.1.7",
    "prettier": "^3.6.0",
    "prettier-plugin-tailwindcss": "^0.7.1",
    "turbo": "^2.7.2"
  },
  "packageManager": "pnpm@10.27.0",
  "engines": {
    "node": ">=24.14.1"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "sharp",
      "esbuild",
      "unrs-resolver"
    ],
    "overrides": {
      "@esbuild-kit/core-utils>esbuild": "0.25.12",
      "@neondatabase/api-client>axios": "1.15.2",
      "@payloadcms/email-nodemailer>nodemailer": "8.0.7",
      "jsdom>ws": "8.20.1",
      "monaco-editor>dompurify": "3.4.5",
      "uuid": "11.1.1"
    }
  }
}
