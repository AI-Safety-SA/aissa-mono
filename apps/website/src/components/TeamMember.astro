---
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';
import GenericCard from './GenericCard.astro';
import PrimaryButton from './PrimaryButton.astro';

export interface Props {
  name: string;
  role: string;
  image: ImageMetadata;
  link: string;
  bio: string;
}
const { name, role, image, link, bio } = Astro.props;
---

<GenericCard>
  <div slot="content" class="flex flex-col h-full text-left">
    <h2 class="text-sub-heading mb-1">{name}</h2>
    <h3 class="text-label text-muted mb-4">{role}</h3>
    <p class="text-body flex-1">{bio}</p>
    <div class="mt-6">
      <PrimaryButton text="View Profile" link={link} alt={`View ${name}'s profile`} />
    </div>

  </div>

  <div slot="image" class="flex flex-col items-center gap-4">
    <Image
      src={image}
      alt={`${name} headshot`}
      width={220}
      height={220}
      class="w-40 h-40 lg:w-56 lg:h-56 object-cover rounded-2xl"
    />
  </div>
</GenericCard>
