---
import { joinWithBase } from '../utils/url';
import logo from '../assets/aissa_logo_eggshell_text_transparent_background.png';
import NavItem from './NavItem.astro';

const navItems = [
  { href: '/', display_name: 'Home' },
  { href: '/team', display_name: 'Team' },
  { href: 'https://aisafetysouthafrica.substack.com/', display_name: 'Blog' },
  { href: '/about', display_name: 'About' },
  { href: '/get-involved', display_name: 'Get Involved' },
];
---

<nav id="header-nav" class="nav-shell">
  <div class="mx-auto max-w-[1800px] px-4 pt-4 sm:px-7 lg:px-9 lg:pt-6">
    <div class="flex items-start justify-between gap-6">
      <a
        href={joinWithBase(import.meta.env.BASE_URL, '/')}
        class="nav-brand flex min-w-0 items-start"
      >
        <img
          src={logo.src}
          class="h-20 w-auto sm:h-24 lg:h-28 xl:h-32"
          alt="AI Safety South Africa Logo"
        />
      </a>

      <ul class="hidden items-center gap-8 pt-7 md:flex lg:gap-12 xl:gap-16">
        {navItems.map((item) => <NavItem href={item.href} display_name={item.display_name} />)}
      </ul>

      <button
        id="hamburger-menu"
        type="button"
        class="nav-toggle mt-4 inline-flex items-center justify-center md:hidden"
        aria-controls="navbar-mobile"
        aria-expanded="false"
      >
        <span class="sr-only">Open main menu</span>
        <svg
          class="h-10 w-10"
          aria-hidden="true"
          fill="none"
          stroke="currentColor"
          viewBox="0 0 24 24"
          xmlns="http://www.w3.org/2000/svg"
        >
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.25" d="M4 7h16M4 12h16M4 17h16"></path>
        </svg>
      </button>
    </div>

    <div class="mobile-nav-panel hidden md:hidden" id="navbar-mobile">
      <div class="px-5 pb-5 pt-2">
        <ul class="mobile-nav-link-list flex flex-col gap-2">
          {navItems.map((item) => <NavItem href={item.href} display_name={item.display_name} />)}
        </ul>
      </div>
    </div>
  </div>
</nav>

<script>
  document.addEventListener('DOMContentLoaded', function () {
    const hamburgerButton = document.getElementById('hamburger-menu');
    const navbarMenu = document.getElementById('navbar-mobile');
    const headerNav = document.getElementById('header-nav');

    let lastScrollTop = 0;
    const scrollThreshold = 10;
    let isScrolling = false;

    function setMenuOpen(nextState: boolean) {
      if (!hamburgerButton || !navbarMenu || !headerNav) return;

      hamburgerButton.setAttribute('aria-expanded', String(nextState));
      headerNav.classList.toggle('is-menu-open', nextState);
      navbarMenu.classList.toggle('hidden', !nextState);
    }

    function isMenuOpen() {
      return hamburgerButton?.getAttribute('aria-expanded') === 'true';
    }

    function closeMenu() {
      setMenuOpen(false);
    }

    function isDesktopViewport() {
      return window.innerWidth >= 768;
    }

    function applyScrolledState(scrollTop: number) {
      if (!headerNav) return;
      if (scrollTop > 18) {
        headerNav.classList.add('is-scrolled');
      } else {
        headerNav.classList.remove('is-scrolled');
      }
    }

    function handleScroll() {
      if (isScrolling) return;

      isScrolling = true;
      requestAnimationFrame(() => {
        const scrollTop = window.pageYOffset || document.documentElement.scrollTop;
        const scrollDelta = scrollTop - lastScrollTop;

        applyScrolledState(scrollTop);

        if (isMenuOpen()) {
          headerNav?.classList.remove('-translate-y-full');
          lastScrollTop = scrollTop;
          isScrolling = false;
          return;
        }

        if (isDesktopViewport() && Math.abs(scrollDelta) > scrollThreshold) {
          if (scrollDelta > 0 && scrollTop > 100) {
            headerNav?.classList.add('-translate-y-full');
          } else if (scrollDelta < 0) {
            headerNav?.classList.remove('-translate-y-full');
          }
          lastScrollTop = scrollTop;
        } else if (!isDesktopViewport()) {
          headerNav?.classList.remove('-translate-y-full');
          lastScrollTop = scrollTop;
        }

        isScrolling = false;
      });
    }

    applyScrolledState(window.pageYOffset || document.documentElement.scrollTop);
    window.addEventListener('scroll', handleScroll, { passive: true });

    if (hamburgerButton && navbarMenu) {
      hamburgerButton.addEventListener('click', function () {
        setMenuOpen(!isMenuOpen());
      });

      document.addEventListener('click', function (event) {
        const target = event.target as Node;
        if (!hamburgerButton.contains(target) && !navbarMenu.contains(target)) {
          closeMenu();
        }
      });

      navbarMenu.querySelectorAll('a').forEach((link) => {
        link.addEventListener('click', closeMenu);
      });

      window.addEventListener('keydown', function (event) {
        if (event.key === 'Escape') {
          closeMenu();
        }
      });

      window.addEventListener('resize', function () {
        if (isDesktopViewport()) {
          closeMenu();
        }
      });
    }
  });
</script>
