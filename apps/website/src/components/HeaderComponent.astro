---
import { joinWithBase } from '../utils/url';
import logo from '../assets/aissa_logo_eggshell_text_transparent_background.png';
import NavItem from './NavItem.astro';
---

<nav
  id="header-nav"
  class="nav-shell"
>
  <div
    class="max-w-7xl flex flex-nowrap items-center justify-between mx-auto py-4 sm:py-5 px-4 sm:px-6 lg:px-8"
  >
    <a
      href={joinWithBase(import.meta.env.BASE_URL, '/')}
      class="flex items-center space-x-3 sm:space-x-4 rtl:space-x-reverse"
    >
      <img src={logo.src} class="h-10 sm:h-12 lg:h-14 w-auto" alt="AI Safety South Africa Logo" />
    </a>

    <div class="hidden md:flex md:items-center md:space-x-8 lg:space-x-10">
      <NavItem href="/" display_name="Home" />
      <NavItem href="/team" display_name="Team" />
      <NavItem href="https://aisafetysouthafrica.substack.com/" display_name="Blog" />
      <NavItem href="/about" display_name="About" />
      <NavItem href="/get-involved" display_name="Get Involved" />
    </div>

    <button
      id="hamburger-menu"
      type="button"
      class="inline-flex items-center p-2.5 w-11 h-11 justify-center text-sm text-nav-text rounded-lg md:hidden hover:bg-white/10 transition-colors"
      aria-controls="navbar-mobile"
      aria-expanded="false"
    >
      <span class="sr-only">Open main menu</span>
      <svg
        class="w-6 h-6"
        aria-hidden="true"
        fill="none"
        stroke="currentColor"
        viewBox="0 0 24 24"
        xmlns="http://www.w3.org/2000/svg"
        ><path
          stroke-linecap="round"
          stroke-linejoin="round"
          stroke-width="2"
          d="M4 6h16M4 12h16M4 18h16"></path></svg
      >
    </button>
  </div>

  <div
    class="mobile-nav-panel hidden absolute left-0 top-full w-full rounded-b-xl z-40 md:w-auto md:shadow-none md:rounded-none md:border-0"
    id="navbar-mobile"
  >
    <ul class="flex flex-col py-6 px-4 space-y-3">
      <NavItem href="/" display_name="Home" />
      <NavItem href="/team" display_name="Team" />
      <NavItem href="https://aisafetysouthafrica.substack.com/" display_name="Blog" />
      <NavItem href="/about" display_name="About" />
      <NavItem href="/get-involved" display_name="Get Involved" />
    </ul>
  </div>
</nav>

<script>
  document.addEventListener('DOMContentLoaded', function () {
    const hamburgerButton = document.getElementById('hamburger-menu');
    const navbarMenu = document.getElementById('navbar-mobile');
    const headerNav = document.getElementById('header-nav');

    let lastScrollTop = 0;
    const scrollThreshold = 10;
    let isScrolling = false;

    function applyScrolledState(scrollTop: number) {
      if (!headerNav) return;
      if (scrollTop > 18) {
        headerNav.classList.add('is-scrolled');
      } else {
        headerNav.classList.remove('is-scrolled');
      }
    }

    function handleScroll() {
      if (isScrolling) return;

      isScrolling = true;
      requestAnimationFrame(() => {
        const scrollTop = window.pageYOffset || document.documentElement.scrollTop;
        const scrollDelta = scrollTop - lastScrollTop;

        applyScrolledState(scrollTop);

        if (Math.abs(scrollDelta) > scrollThreshold) {
          if (scrollDelta > 0 && scrollTop > 100) {
            headerNav?.classList.add('-translate-y-full');
          } else if (scrollDelta < 0) {
            headerNav?.classList.remove('-translate-y-full');
          }
          lastScrollTop = scrollTop;
        }

        isScrolling = false;
      });
    }

    applyScrolledState(window.pageYOffset || document.documentElement.scrollTop);
    window.addEventListener('scroll', handleScroll, { passive: true });

    if (hamburgerButton && navbarMenu) {
      hamburgerButton.addEventListener('click', function () {
        const isExpanded = hamburgerButton.getAttribute('aria-expanded') === 'true';

        hamburgerButton.setAttribute('aria-expanded', (!isExpanded).toString());

        if (isExpanded) {
          navbarMenu.classList.add('hidden');
        } else {
          navbarMenu.classList.remove('hidden');
        }
      });

      document.addEventListener('click', function (event) {
        const target = event.target as Node;
        if (!hamburgerButton.contains(target) && !navbarMenu.contains(target)) {
          hamburgerButton.setAttribute('aria-expanded', 'false');
          navbarMenu.classList.add('hidden');
        }
      });

      window.addEventListener('resize', function () {
        if (window.innerWidth >= 768) {
          hamburgerButton.setAttribute('aria-expanded', 'false');
          navbarMenu.classList.add('hidden');
        }
      });
    }
  });
</script>
