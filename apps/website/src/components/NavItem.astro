---
import { joinWithBase } from '../utils/url';

export interface Props {
  href: string;
  display_name: string;
}

const { href, display_name } = Astro.props;

let full = joinWithBase(import.meta.env.BASE_URL, href);
const normalizePath = (path: string) => (path.length > 1 && path.endsWith('/') ? path.slice(0, -1) : path);
const isActive = normalizePath(Astro.url.pathname) === normalizePath(full);
---

<li class="list-none">
  <a href={full} class:list={['nav-link', { 'is-active': isActive }]}>
    {display_name}
  </a>
</li>
