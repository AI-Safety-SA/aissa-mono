---
import { Image } from 'astro:assets';

export interface Props {
  logos: { image: ImageMetadata; alt: string }[];
  heading?: string;
  speedSeconds?: number;
  pauseOnHover?: boolean;
  background?: string;
  showDivider?: boolean;
  marquee?: boolean;
}

const {
  logos,
  heading,
  speedSeconds = 22,
  pauseOnHover = true,
  background = 'var(--color-partner-bg)',
  showDivider = false,
  marquee = true,
} = Astro.props;
---

<section class="w-full py-6 px-0 overflow-hidden" style={`background: ${background};`}>
  <div class="max-w-7xl mx-auto">
    {
      heading && (
        <h2 class="text-3xl md:text-4xl text-center text-heading mb-8 px-4">
          {heading}
        </h2>
      )
    }

    <div
      class:list={[
        'partner-banner-wrapper relative w-full overflow-hidden',
        { border: showDivider },
      ]}
      style={`border-color: var(--color-partner-border); ${showDivider ? '' : 'box-shadow: none;'}`}
    >
      {
        marquee ? (
          <div
            class:list={[
              'partner-banner-track flex items-center py-5 md:py-6 gap-8 md:gap-11 lg:gap-14',
              { 'pause-on-hover': pauseOnHover },
            ]}
            style={`--marquee-duration: ${speedSeconds}s;`}
          >
            {logos.map((logo, index) => (
              <div
                class:list={[
                  'partner-logo-item flex-shrink-0 min-w-[140px] md:min-w-[170px]',
                  { 'pl-4': index === 0 },
                ]}
              >
                <Image
                  src={logo.image}
                  alt={logo.alt}
                  class="h-10 md:h-12 lg:h-14 w-auto object-contain grayscale-[10%] contrast-110 transition-all duration-300"
                  width={220}
                  height={96}
                />
              </div>
            ))}
            {logos.map((logo) => (
              <div class="partner-logo-item flex-shrink-0 min-w-[140px] md:min-w-[170px]">
                <Image
                  src={logo.image}
                  alt={logo.alt}
                  class="h-10 md:h-12 lg:h-14 w-auto object-contain grayscale-[10%] contrast-110 transition-all duration-300"
                  width={220}
                  height={96}
                />
              </div>
            ))}
          </div>
        ) : (
          <div class="flex items-center justify-between py-5 md:py-6 px-3 md:px-6 lg:px-10 gap-4 md:gap-6 overflow-x-auto">
            {logos.map((logo) => (
              <div class="flex-shrink-0 min-w-[90px] md:min-w-[120px]">
                <Image
                  src={logo.image}
                  alt={logo.alt}
                  class="h-10 md:h-12 lg:h-14 w-auto object-contain"
                  width={220}
                  height={96}
                />
              </div>
            ))}
          </div>
        )
      }
    </div>
  </div>
</section>
