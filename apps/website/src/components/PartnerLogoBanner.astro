---
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';

export interface Props {
  logos: { image: ImageMetadata; alt: string; size: 'small' | 'medium' | 'large' }[];
  speedSeconds?: number;
  pauseOnHover?: boolean;
  background?: string;
  showDivider?: boolean;
  marquee?: boolean;
}

const {
  logos,
  speedSeconds = 22,
  pauseOnHover = false,
  background = 'var(--color-partner-bg)',
  showDivider = false,
  marquee = true,
} = Astro.props;

const logoHeightClasses: Record<Props['logos'][number]['size'], string> = {
  small: 'h-8 md:h-10 lg:h-12',
  medium: 'h-10 md:h-12 lg:h-14',
  large: 'h-12 md:h-14 lg:h-16',
};
---

<section class="w-full px-0 overflow-hidden" style={`background: ${background};`}>
  <div class="max-w-7xl mx-auto">
    <div
      class:list={[
        'partner-banner-wrapper relative w-full overflow-hidden rounded-[1.75rem] md:rounded-4xl',
        { border: showDivider },
      ]}
      style={`border-color: var(--color-partner-border); ${showDivider ? '' : 'box-shadow: none;'}`}
    >
      {
        marquee ? (
          <>
            <div class="grid grid-cols-2 gap-3 p-4 sm:grid-cols-3 md:hidden">
              {logos.map((logo) => (
                <div class="partner-logo-tile flex min-h-22 items-center justify-center rounded-2xl px-4 py-5">
                  <Image
                    src={logo.image}
                    alt={logo.alt}
                    class:list={['w-auto max-w-full object-contain', logoHeightClasses[logo.size]]}
                    width={220}
                    height={96}
                  />
                </div>
              ))}
            </div>

            <div
              class:list={[
                'partner-banner-track hidden md:flex md:items-center md:gap-7 md:py-6 lg:gap-9',
                { 'pause-on-hover': pauseOnHover },
              ]}
              style={`--marquee-duration: ${speedSeconds}s;`}
            >
              {logos.map((logo, index) => (
                <div class:list={['partner-logo-item shrink-0', { 'pl-4': index === 0 }]}>
                  <Image
                    src={logo.image}
                    alt={logo.alt}
                    class:list={[
                      'w-auto max-w-[14rem] object-contain contrast-110 transition-all duration-300 lg:max-w-[16rem]',
                      logoHeightClasses[logo.size],
                    ]}
                  />
                </div>
              ))}
              {logos.map((logo) => (
                <div class="partner-logo-item shrink-0" aria-hidden="true">
                  <Image
                    src={logo.image}
                    alt=""
                    class:list={[
                      'w-auto max-w-[14rem] object-contain contrast-110 transition-all duration-300 lg:max-w-[16rem]',
                      logoHeightClasses[logo.size],
                    ]}
                  />
                </div>
              ))}
            </div>
          </>
        ) : (
          <div class="flex items-center justify-between gap-4 overflow-x-auto px-3 py-5 md:gap-6 md:px-6 md:py-6 lg:px-10">
            {logos.map((logo) => (
              <div class="partner-logo-tile flex shrink-0 items-center justify-center rounded-2xl px-4 py-4 min-w-35 md:min-w-40">
                <Image
                  src={logo.image}
                  alt={logo.alt}
                  class:list={['w-auto object-contain', logoHeightClasses[logo.size]]}
                />
              </div>
            ))}
          </div>
        )
      }
    </div>
  </div>
</section>
