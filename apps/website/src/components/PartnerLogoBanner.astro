---
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';

export interface Props {
  logos: { image: ImageMetadata; alt: string }[];
  heading?: string;
  speedSeconds?: number;
  pauseOnHover?: boolean;
  background?: string;
  showDivider?: boolean;
  marquee?: boolean;
}

const {
  logos,
  heading,
  speedSeconds = 22,
  pauseOnHover = true,
  background = 'var(--color-partner-bg)',
  showDivider = false,
  marquee = true,
} = Astro.props;
---

<section class="w-full py-6 px-0 overflow-hidden" style={`background: ${background};`}>
  <div class="max-w-7xl mx-auto">
    {
      heading && (
        <h2 class="text-3xl md:text-4xl text-center text-heading mb-8 px-4">
          {heading}
        </h2>
      )
    }

    <div
      class:list={[
        'partner-banner-wrapper relative w-full overflow-hidden rounded-[1.75rem] md:rounded-[2rem]',
        { border: showDivider },
      ]}
      style={`border-color: var(--color-partner-border); ${showDivider ? '' : 'box-shadow: none;'}`}
    >
      {
        marquee ? (
          <>
            <div class="grid grid-cols-2 gap-3 p-4 sm:grid-cols-3 md:hidden">
              {logos.map((logo) => (
                <div class="partner-logo-tile flex min-h-[88px] items-center justify-center rounded-2xl px-4 py-5">
                  <Image
                    src={logo.image}
                    alt={logo.alt}
                    class="h-10 w-auto max-w-full object-contain"
                    width={220}
                    height={96}
                  />
                </div>
              ))}
            </div>

            <div
              class:list={[
                'partner-banner-track hidden md:flex md:items-center md:gap-11 md:py-6 lg:gap-14',
                { 'pause-on-hover': pauseOnHover },
              ]}
              style={`--marquee-duration: ${speedSeconds}s;`}
            >
              {logos.map((logo, index) => (
                <div
                  class:list={[
                    'partner-logo-item flex-shrink-0 min-w-[170px]',
                    { 'pl-4': index === 0 },
                  ]}
                >
                  <Image
                    src={logo.image}
                    alt={logo.alt}
                    class="h-12 w-auto object-contain grayscale-[10%] contrast-110 transition-all duration-300 lg:h-14"
                    width={220}
                    height={96}
                  />
                </div>
              ))}
              {logos.map((logo) => (
                <div class="partner-logo-item flex-shrink-0 min-w-[170px]" aria-hidden="true">
                  <Image
                    src={logo.image}
                    alt=""
                    class="h-12 w-auto object-contain grayscale-[10%] contrast-110 transition-all duration-300 lg:h-14"
                    width={220}
                    height={96}
                  />
                </div>
              ))}
            </div>
          </>
        ) : (
          <div class="flex items-center justify-between gap-4 overflow-x-auto px-3 py-5 md:gap-6 md:px-6 md:py-6 lg:px-10">
            {logos.map((logo) => (
              <div class="partner-logo-tile flex flex-shrink-0 items-center justify-center rounded-2xl px-4 py-4 min-w-[140px] md:min-w-[160px]">
                <Image
                  src={logo.image}
                  alt={logo.alt}
                  class="h-10 md:h-12 lg:h-14 w-auto object-contain"
                  width={220}
                  height={96}
                />
              </div>
            ))}
          </div>
        )
      }
    </div>
  </div>
</section>
