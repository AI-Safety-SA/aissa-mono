---
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';

export interface Props {
  logos: { image: ImageMetadata; alt: string; renderSize: 'small' | 'medium' | 'large' }[];
  speedSeconds?: number;
  pauseOnHover?: boolean;
  background?: string;
  showDivider?: boolean;
  marquee?: boolean;
}

const {
  logos,
  speedSeconds = 32,
  pauseOnHover = false,
  showDivider = false,
  marquee = true,
} = Astro.props;

const logoHeightClasses: Record<Props['logos'][number]['renderSize'], string> = {
  small: 'h-8 md:h-10 lg:h-12',
  medium: 'h-10 md:h-12 lg:h-14',
  large: 'h-14 md:h-16 lg:h-18',
};
---

<div class="mx-auto max-w-7xl md:max-w-none">
  <div
    class="partner-banner-wrapper relative w-full overflow-hidden rounded-[1.75rem] md:rounded-none contrast-[1.1]"
    style={showDivider ? undefined : 'box-shadow: none;'}
  >
    {
      marquee ? (
        <>
          <div
            class:list={[
              'partner-banner-track flex items-center gap-5 py-4 sm:gap-6 md:gap-7 md:py-6 lg:gap-9',
              { 'pause-on-hover': pauseOnHover },
            ]}
            style={`--marquee-duration: ${speedSeconds}s;`}
          >
            {logos.map((logo) => (
              <div class="partner-logo-item shrink-0">
                <Image
                  src={logo.image}
                  alt={logo.alt}
                  class:list={[
                    'w-auto max-w-56 object-contain lg:max-w-[16rem]',
                    logoHeightClasses[logo.renderSize],
                  ]}
                />
              </div>
            ))}
            {logos.map((logo) => (
              <div class="partner-logo-item shrink-0" aria-hidden="true">
                <Image
                  src={logo.image}
                  alt=""
                  class:list={[
                    'w-auto max-w-56 object-contain lg:max-w-[16rem]',
                    logoHeightClasses[logo.renderSize],
                  ]}
                />
              </div>
            ))}
          </div>
        </>
      ) : (
        <div class="flex items-center justify-between gap-4 overflow-x-auto px-3 py-5 md:gap-6 md:px-6 md:py-6 lg:px-10">
          {logos.map((logo) => (
            <div class="partner-logo-tile flex shrink-0 items-center justify-center rounded-2xl px-4 py-4 min-w-35 md:min-w-40">
              <Image
                src={logo.image}
                alt={logo.alt}
                class:list={['w-auto object-contain', logoHeightClasses[logo.renderSize]]}
              />
            </div>
          ))}
        </div>
      )
    }
  </div>
</div>
