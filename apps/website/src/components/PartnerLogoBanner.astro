---
import { Image } from 'astro:assets';

export interface Props {
  logos: { image: ImageMetadata; alt: string }[];
  heading?: string;
  speedSeconds?: number;
  pauseOnHover?: boolean;
}

const {
  logos,
  heading = 'Our Partners',
  speedSeconds = 22,
  pauseOnHover = true,
} = Astro.props;
---

<section class="w-full py-14 px-4 overflow-hidden" style="background: var(--color-partner-bg);">
  <div class="max-w-7xl mx-auto">
    <h2 class="text-3xl md:text-4xl text-center text-heading mb-8">{heading}</h2>

    <div
      class="partner-banner-wrapper relative w-full overflow-hidden rounded-2xl border"
      style="border-color: var(--color-partner-border); box-shadow: 0 10px 30px var(--color-partner-shadow);"
    >
      <div
        class:list={[
          'partner-banner-track flex items-center py-6 md:py-7 gap-8 md:gap-11 lg:gap-14',
          { 'pause-on-hover': pauseOnHover },
        ]}
        style={`--marquee-duration: ${speedSeconds}s;`}
      >
        {
          logos.map((logo) => (
            <div class="partner-logo-item flex-shrink-0 min-w-[140px] md:min-w-[170px]">
              <Image
                src={logo.image}
                alt={logo.alt}
                class="h-11 md:h-14 lg:h-16 w-auto object-contain grayscale-[25%] contrast-110 transition-all duration-300"
                width={220}
                height={96}
              />
            </div>
          ))
        }
        {
          logos.map((logo) => (
            <div class="partner-logo-item flex-shrink-0 min-w-[140px] md:min-w-[170px]">
              <Image
                src={logo.image}
                alt={logo.alt}
                class="h-11 md:h-14 lg:h-16 w-auto object-contain grayscale-[25%] contrast-110 transition-all duration-300"
                width={220}
                height={96}
              />
            </div>
          ))
        }
      </div>
    </div>
  </div>
</section>
