---
import Image from 'astro/components/Image.astro';

export interface Props {
  source: ImageMetadata;
  alt_text: string;
}

const { source, alt_text } = Astro.props;
---

<div class="carousel-slide shrink-0 w-full">
  <a href={source.src} class="glightbox" data-gallery="cottage">
    <Image
      src={source}
      alt={alt_text}
      class="w-full h-56 md:h-[26rem] lg:h-[32rem] xl:h-[36rem] object-cover cursor-pointer"
    />
  </a>
</div>
