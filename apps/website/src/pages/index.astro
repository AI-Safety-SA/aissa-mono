---
import SecondaryButton from '../components/SecondaryButton.astro';
import Layout from '../layouts/Layout.astro';
import { Image } from 'astro:assets';
import PartnerLogoBanner from '../components/PartnerLogoBanner.astro';
import type { Props as PartnerLogoBannerProps } from '../components/PartnerLogoBanner.astro';
import GetInvolvedSection from '../components/GetInvolvedSection.astro';
import tableMountain from '../assets/table_mountain_midjourney_compressed.png';

// Import all partner logos
import apartLogo from '../assets/partner_logos/apart_logo.png';
import ashgroLogo from '../assets/partner_logos/ashgro-logo.png';
import condorLogo from '../assets/partner_logos/condor-initiative.png';
import coopAILogo from '../assets/partner_logos/CoopAI_Primary_Black.png';
import eaSaLogo from '../assets/partner_logos/EA-SA-horizontal-logo.png';
import ilinaLogo from '../assets/partner_logos/Ilina -program.png';
import lambdaLogo from '../assets/partner_logos/lambda_logo_stacked_black.svg';
import openphilLogo from '../assets/partner_logos/openphil_logo.svg';
import indabaXLogo from '../assets/partner_logos/indabax-logo.png';
import uctAiLogo from '../assets/partner_logos/uct-ai-initiative.png';
import uctPartnerLogo from '../assets/partner_logos/uct-partner.png';
import witsLogo from '../assets/partner_logos/wits-logo.png';

// Logo size is how large the actual image is. This will inversely correlate with the m
const partnerLogos: PartnerLogoBannerProps['logos'] = [
  { image: coopAILogo, alt: 'CoopAI Logo', size: 'medium' },
  { image: uctAiLogo, alt: 'UCT AI Initiative Logo', size: 'medium' },
  { image: openphilLogo, alt: 'Open Philanthropy Logo', size: 'medium' },
  { image: uctPartnerLogo, alt: 'UCT Partner Logo', size: 'medium' },
  { image: ashgroLogo, alt: 'Ashgro Logo', size: 'medium' },
  { image: apartLogo, alt: 'Apart Logo', size: 'medium' },
  { image: lambdaLogo, alt: 'Lambda Logo', size: 'medium' },
  { image: eaSaLogo, alt: 'Effective Altruism South Africa Logo', size: 'medium' },
  { image: ilinaLogo, alt: 'Ilina Program Logo', size: 'medium' },
  { image: condorLogo, alt: 'Condor Initiative Logo', size: 'medium' },
  { image: witsLogo, alt: 'Wits Logo', size: 'medium' },
  { image: indabaXLogo, alt: 'Deep Learning Indaba X Logo', size: 'medium' },
];
---

<Layout title="AI Safety South Africa">
  <main class="w-full">
    <section
      class="relative h-screen w-full flex items-center justify-center overflow-hidden pt-10 md:pt-0"
    >
      <div class="absolute inset-0 z-0">
        <Image
          src={tableMountain}
          alt="Table Mountain Background"
          class="w-full h-full object-cover object-center"
        />
      </div>

      <div class="relative z-10 text-center text-white px-4 max-w-4xl mx-auto">
        <h1
          class="text-[40px] font-semibold mb-8 leading-11.25 tracking-[-0.02em] drop-shadow-[0_10px_26px_rgba(0,0,0,0.38)] text-surface"
        >
          Bringing the world's most important conversation to the tip of Africa
        </h1>
        <SecondaryButton text="Learn More" link="/about" alt="Learn More" />
      </div>
    </section>

    <PartnerLogoBanner logos={partnerLogos} marquee={true} speedSeconds={32} />

    <section class="w-full px-4 md:px-6 py-18 md:py-24 bg-section-slate">
      <GetInvolvedSection />
    </section>
  </main>
</Layout>
