---
import Layout from '../layouts/Layout.astro';
import ImageCarousel from '../components/ImageCarousel.astro';

const eventPhotoModules = import.meta.glob(
  '../assets/event_photos/*.{jpg,jpeg,JPG,JPEG,png,PNG,webp,WEBP,avif,AVIF}',
  {
    eager: true,
    import: 'default',
  }
) as Record<string, ImageMetadata>;

const eventPhotoMetadata: Record<string, { alt_text: string; order: number }> = {
  '2026_kickoff_event_leo_claude_tegan.jpg': {
    alt_text: 'Leo, Claude, and Tegan at the 2026 AISSA kickoff event',
    order: 1,
  },
  'cairf_retreat_working.JPG': {
    alt_text: 'AISSA team members working together at the CAIRF retreat',
    order: 2,
  },
  'crowd_indabaxs_2023.jpeg': {
    alt_text: 'Audience gathered at Deep Learning IndabaX 2023',
    order: 3,
  },
  'DLIX_2025_charl.jpeg': {
    alt_text: 'Charl speaking at Deep Learning IndabaX 2025',
    order: 4,
  },
  'leo_indabaxs_2023.jpg': {
    alt_text: 'Leo presenting at Deep Learning IndabaX 2023',
    order: 5,
  },
  'reading_group_iabied.jpg': {
    alt_text: 'AISSA reading group session with Iabied',
    order: 6,
  },
  'stellies_ai_safety_workshop.jpeg': {
    alt_text: 'Participants at the Stellenbosch AI safety workshop',
    order: 7,
  },
};

const eventPhotos = Object.entries(eventPhotoModules)
  .map(([path, image]) => {
    const filename = path.split('/').pop();
    if (!filename) return null;

    const metadata = eventPhotoMetadata[filename];
    if (!metadata) return null;

    return {
      image,
      alt_text: metadata.alt_text,
      order: metadata.order,
    };
  })
  .filter((photo) => photo !== null)
  .sort((a, b) => a.order - b.order)
  .map(({ image, alt_text }) => ({ image, alt_text }));
---

<Layout title="About | AI Safety South Africa">
  <main class="min-h-screen bg-transparent">
    <section class="mb-[2.4rem] px-4 pb-8 pt-28 sm:px-6">
      <div class="mt-6 md:mt-8">
        <div class="container mx-auto max-w-6xl lg:max-w-7xl xl:max-w-[88rem] pb-7 pt-2">
          <ImageCarousel image_list={eventPhotos} />
        </div>

        <div class="max-w-6xl mx-auto">
          <div class="surface-card rounded-4xl p-7 md:p-9">
            <div class="grid gap-6 md:gap-8">
              <div>
                <h2 class="text-sub-heading text-left">Research</h2>
                <p class="text-body text-left">
                  Our research lab is currently studying LLMs' potential impact on human agency,
                  both positively and negatively. Our lab is guided by Apart Labs, and we have
                  research mentors at top AI labs and universities, such as the Stanford AI Lab and
                  New York University. We have also assisted with community-led research projects
                  from our fellowship participants, which include overviews on AI Alignments and
                  various studies on AI preparedness in Africa.
                </p>
              </div>

              <div>
                <h2 class="text-sub-heading text-left">Fellowships</h2>
                <p class="text-body text-left">
                  We run AI Safety Fundamentals (AISF) fellowships, where we run participants
                  through an internationally recognized curriculum. This consists of a set of
                  readings and exercises, alongside a reading group led by one of our facilitators.
                </p>
              </div>

              <div>
                <h2 class="text-sub-heading text-left">Workshops</h2>
                <p class="text-body text-left">
                  We run workshops at top national conferences, such as the Deep Learning IndabaX,
                  and SACAIR. These interactive sessions are aimed at engaging ML researchers in the
                  fundamentals of AI Safety and communicating the most promising areas of research
                  in this quickly evolving field.
                </p>
              </div>

              <div>
                <h2 class="text-sub-heading text-left">Events</h2>
                <p class="text-body text-left">
                  We regularly host meetups in Cape Town, where our community converges to discuss
                  AI Safety, and generally hang out and socialize. These we normally host at some of
                  the beautiful locations in Cape Town, and are highly engaging community-building
                  events.
                </p>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>
  </main>
</Layout>
