---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Get Involved | AI Safety South Africa">
  <main class="min-h-screen">
    <section class="get-involved-wrap">
      <div class="get-involved-card">
        <h1>Get Involved</h1>

        <div class="content-stack">
          <div>
            <h3>Cooperative AI Research Fellowship</h3>
            <p>
              We are hosting a 3-month research fellowship developing core topics in cooperative AI,
              with world-class mentorship. Applications close on the 28th of September 2025. Find out more and apply on the
              <a href="https://www.cai-research-fellowship.com/" target="_blank" rel="noopener"
                >website</a
              >.
            </p>
          </div>

          <div>
            <h3>Learn More</h3>
            <p>
              If you would like to learn more about AI Safety,
              <a
                href="https://docs.google.com/document/d/1ggO5P0Tlsf2FF1kODc6G6_DZWIsERtI2hyIn74XOwgk/edit?tab=t.0"
                target="_blank"
                rel="noopener">here are some resources that we recommend</a
              >
              and that we keep up-to-date.
            </p>
          </div>

          <div>
            <h3>Contribute to AI safety work in South Africa</h3>
            <p>
              We’re looking for volunteers to support research, organise events, and build our
              community.
              <a
                href="https://tally.so/r/w4gD7b"
                target="_blank"
                rel="noopener">Apply now</a
              >—we’ll match you with opportunities that fit your skills and schedule.
            </p>
          </div>

          <div>
            <h3>Events Calendar</h3>
            <p>
              We regularly host in-person events in Cape Town, as well as occasionally host online
              talks. You can stay up to date with events via our
              <a href="https://lu.ma/calendar/cal-p3BboQFpGbi3ioe" target="_blank" rel="noopener"
                >Luma calendar</a
              >.
            </p>
          </div>

          <div>
            <h3>Substack Newsletter</h3>
            <p>
              We post a ~monthly newsletter, please
              <a href="https://aisafetysouthafrica.substack.com/" target="_blank" rel="noopener"
                >subscribe to our Substack</a
              >.
            </p>
          </div>

          <div>
            <h3>Co-Working Space</h3>
            <p>
              Apply to work at our beautiful
              <a
                href="https://airtable.com/appR0NwXFE9nxfdKA/pagIQJbgF9MMX1SMu/form"
                target="_blank"
                rel="noopener">co-working space</a
              >.
            </p>
          </div>

          <div>
            <h3>Social Media</h3>
            <p>
              Follow us on
              <a
                href="https://www.linkedin.com/company/ai-safety-south-africa/"
                target="_blank"
                rel="noopener">LinkedIn</a
              >.
            </p>
          </div>

          <div>
            <h3>Donations</h3>
            <p>
              If you'd like to support the work we do financially, please make a
              <a
                href="https://www.every.org/ai-safety-cape-town?utm_campaign=donate-link#/donate"
                target="_blank"
                rel="noopener">donation here</a
              >.
            </p>
          </div>
        </div>
      </div>
    </section>
  </main>
</Layout>

<style>
  .get-involved-wrap {
    margin-top: 72px;
    padding: 2.2rem 1rem 3.7rem;
    background: linear-gradient(180deg, #0f4a68 0%, #9aabb0 28%, #efecdf 28%, #efecdf 100%);
    min-height: calc(100vh - 72px);
  }

  .get-involved-card {
    max-width: 1100px;
    margin: 0 auto;
    background: #efecdf;
    border-radius: 30px;
    padding: 2.2rem 2rem 2.4rem;
    box-shadow: 0 10px 24px rgba(22, 41, 57, 0.14);
  }

  .get-involved-card h1 {
    margin: 0 0 1.5rem;
    text-align: center;
    color: #203447;
    font-size: 3.45rem;
    line-height: 1;
    font-family: var(--font-display);
    font-weight: 700;
  }

  .content-stack {
    max-width: 930px;
    margin: 0 auto;
    text-align: center;
    display: grid;
    gap: 1rem;
  }

  .content-stack h3 {
    margin: 0 0 0.25rem;
    color: #122639;
    font-size: 1.85rem;
    line-height: 1.15;
    font-family: var(--font-body);
    font-weight: 800;
  }

  .content-stack p {
    margin: 0;
    color: #173044;
    font-size: 1.02rem;
    line-height: 1.45;
  }

  .content-stack a {
    color: #0f4f87;
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  @media (max-width: 900px) {
    .get-involved-wrap {
      padding: 1rem 0.65rem 2.6rem;
    }

    .get-involved-card {
      border-radius: 20px;
      padding: 1.5rem 1rem 1.8rem;
    }

    .get-involved-card h1 {
      font-size: 2.3rem;
    }

    .content-stack h3 {
      font-size: 1.35rem;
    }

    .content-stack p {
      font-size: 0.95rem;
    }
  }
</style>
