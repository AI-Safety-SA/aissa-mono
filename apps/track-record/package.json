{
  "name": "track-record",
  "version": "1.0.0",
  "description": "A Next.js application to display the Track Record of AI Safety SA",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "check-types": "tsc --noEmit",
    "payload": "cross-env NODE_OPTIONS=--no-deprecation payload",
    "payload:local": "cross-env NODE_ENV=development NODE_OPTIONS=--no-deprecation payload",
    "pre-build": "node scripts/run-migrations-unpooled.mjs",
    "build:local": "cross-env NODE_ENV=development next build",
    "dev": "cross-env NODE_ENV=development next dev",
    "seed": "tsx src/seed/index.ts",
    "seed:facilitators": "tsx src/seed/imports/run-facilitator-import.ts",
    "seed:feedback": "tsx src/seed/imports/run-participant-import.ts",
    "seed:events": "tsx src/seed/run-imports.ts",
    "seed:aisf": "tsx src/seed/imports/run-aisf-import.ts",
    "test": "pnpm run test:unit && pnpm run test:int && pnpm run test:e2e",
    "test:unit": "vitest run --config ./vitest.unit.config.mts",
    "test:int": "vitest run --config ./vitest.int.config.mts",
    "test:e2e": "cross-env NODE_OPTIONS=\"--no-deprecation --no-experimental-strip-types\" pnpm exec playwright test",
    "test:all": "pnpm test",
    "test:watch": "vitest --config ./vitest.int.config.mts"
  },
  "dependencies": {
    "@payloadcms/db-postgres": "^3.72.0",
    "@payloadcms/email-nodemailer": "^3.72.0",
    "@payloadcms/next": "^3.72.0",
    "@payloadcms/richtext-lexical": "^3.72.0",
    "@payloadcms/storage-uploadthing": "^3.72.0",
    "@payloadcms/ui": "^3.72.0",
    "@radix-ui/react-slot": "^1.2.4",
    "@repo/ui": "workspace:*",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cross-env": "^7.0.3",
    "csv-parse": "^6.1.0",
    "csv-stringify": "^6.6.0",
    "date-fns": "^4.1.0",
    "dotenv": "16.4.7",
    "graphql": "^16.12.0",
    "lucide-react": "^0.562.0",
    "next": "15.4.10",
    "nodemailer": "^7.0.12",
    "payload": "^3.72.0",
    "react": "19.2.1",
    "react-dom": "19.2.1",
    "sharp": "0.34.2",
    "tailwind-merge": "^3.4.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.3",
    "@neondatabase/api-client": "^2.6.0",
    "@playwright/test": "1.56.1",
    "@repo/tailwind-config": "workspace:*",
    "@tailwindcss/postcss": "^4.1.18",
    "@testing-library/react": "16.3.0",
    "@types/node": "^22.19.7",
    "@types/react": "19.2.1",
    "@types/react-dom": "19.2.1",
    "@vitejs/plugin-react": "4.5.2",
    "autoprefixer": "^10.4.23",
    "eslint": "^9.39.2",
    "eslint-config-next": "15.4.7",
    "jsdom": "26.1.0",
    "playwright": "1.56.1",
    "playwright-core": "1.56.1",
    "postcss": "^8.5.6",
    "prettier": "^3.8.1",
    "tailwindcss": "^4.1.18",
    "tsx": "^4.21.0",
    "typescript": "5.7.3",
    "vite-tsconfig-paths": "5.1.4",
    "vitest": "3.2.3"
  },
  "engines": {
    "node": ">=24.x",
    "pnpm": ">=9"
  }
}
