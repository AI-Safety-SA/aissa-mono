DATABASE_URL=your-db-url
DATABASE_URL_UNPOOLED=unpooled

PAYLOAD_SECRET=payload-prod-secret
FRONTEND_GATE_PASSWORD=shared_frontend_password

R2_ACCESS_KEY_ID=your_access_key_id
R2_SECRET_ACCESS_KEY=your_secret_access_key
R2_BUCKET=aissa-track-record-media
R2_ENDPOINT=<account-id>.r2.cloudflarestorage.com
R2_PUBLIC_URL=https://pub-<hash>.r2.dev

NEON_API_KEY=ky-for-branching-during-test-runs

# WorkOS AuthKit (member auth)
WORKOS_API_KEY=sk_live_example
WORKOS_CLIENT_ID=client_example
WORKOS_COOKIE_PASSWORD=replace_with_a_32_character_minimum_secret
NEXT_PUBLIC_WORKOS_REDIRECT_URI=https://track-record.example.com/callback

# Inngest (event bus)
INNGEST_EVENT_KEY=evt_live_example
INNGEST_SIGNING_KEY=signkey_live_example

SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your-smtp-user
SMTP_PASS=your-smtp-password
SMTP_FROM_NAME="Track Record Admin"
SMTP_FROM_ADDRESS=admin@track-record.co.za
