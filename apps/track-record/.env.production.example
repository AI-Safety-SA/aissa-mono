# .env.production Template for Supabase Sync
# ============================================
# Copy this file to .env.production and fill in your Supabase credentials.

# Supabase Direct Database Connection
# -----------------------------------
# Get this from: Supabase Dashboard > Project Settings > Database > Connection string
# Use the "Direct connection" string (not pooler) for pg_dump/pg_restore
#
# Format: postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres
# 
# Note that this is for the data sync script
# SUPABASE_DATABASE_URL=

# If you want to run the app against Supabase
DATABASE_URL=your-db-url
PAYLOAD_SECRET=payload-prod-secret

UPLOADTHING_TOKEN=your-uploadthing-token

SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your-smtp-user
SMTP_PASS=your-smtp-password
SMTP_FROM_NAME="Track Record Admin"
SMTP_FROM_ADDRESS=admin@track-record.co.za


