DATABASE_URL=direct_connection_string
DATABASE_URL_UNPOOLED=unpooled

PAYLOAD_SECRET=YOUR_SECRET_HERE
FRONTEND_GATE_PASSWORD=shared_frontend_password

LOCAL_ACC_EMAIL=email
LOCAL_ACC_PASSWORD=password

# Cloudflare R2 storage (S3-compatible)
R2_ACCESS_KEY_ID=your_access_key_id
R2_SECRET_ACCESS_KEY=your_secret_access_key
R2_BUCKET=aissa-track-record-media
R2_ENDPOINT=<account-id>.r2.cloudflarestorage.com
R2_PUBLIC_URL=https://pub-<hash>.r2.dev

NEON_API_KEY=ky-for-branching-during-test-runs

# WorkOS AuthKit (member auth)
WORKOS_API_KEY=sk_test_example
WORKOS_CLIENT_ID=client_example
WORKOS_COOKIE_PASSWORD=replace_with_a_32_character_minimum_secret
NEXT_PUBLIC_WORKOS_REDIRECT_URI=http://localhost:3000/callback

# Inngest (event bus)
INNGEST_DEV=1
INNGEST_BASE_URL=http://localhost:8288
# Set these in deployed environments. They are not required when INNGEST_DEV=1.
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=

# Community edit feature
COMMUNITY_EDIT_BASE_URL=http://localhost:3000
COMMUNITY_EDIT_ADMIN_EMAILS=admin@example.com
COMMUNITY_EDIT_MAX_ACTIVE_DRAFTS=3
COMMUNITY_EDIT_RATE_LIMIT_WINDOW_SEC=600
COMMUNITY_EDIT_RATE_LIMIT_MAX_ATTEMPTS=10

# Mailgun
MAILGUN_API_KEY=key-example
MAILGUN_DOMAIN=mg.example.com
MAILGUN_FROM="AISSA <noreply@mg.example.com>"
MAILGUN_BASE_URL=https://api.mailgun.net

SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your-smtp-user
SMTP_PASS=your-smtp-password
SMTP_FROM_NAME="Track Record Admin"
SMTP_FROM_ADDRESS=admin@track-record.co.za
