# Test Environment Variables
# Copy this file to .env.test and fill in the values

# Neon API Key for creating/managing test database branches
# Required for integration tests
NEON_API_KEY=your-neon-api-key-here

# Neon Project ID
# Default: icy-snow-28111680
NEON_PROJECT_ID=icy-snow-28111680

# Payload CMS Secret Key
# Required for Payload CMS initialization
PAYLOAD_SECRET=your-payload-secret-here

# Database URL
# This is automatically set by globalSetup.ts from the Neon test branch
# Do not set manually - it will be overwritten
# DATABASE_URL=

# UploadThing Token (optional, for media uploads in tests)
UPLOADTHING_TOKEN=your-uploadthing-token-here

# SMTP Configuration (optional, for email tests)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your-smtp-user
SMTP_PASS=your-smtp-password
SMTP_FROM_NAME="Track Record Admin"
SMTP_FROM_ADDRESS=admin@track-record.co.za
