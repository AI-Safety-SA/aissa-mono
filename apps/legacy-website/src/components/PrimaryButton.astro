---
export interface Props {
  text: string;
  link: string;
  alt?: string;
  className?: string;
}
const { text, link, alt, className } = Astro.props;
const isExternal = /^(https?:)?\/\//.test(link);
---

<a
  href={link}
  class:list={['btn-primary text-base', className]}
  target={isExternal ? '_blank' : undefined}
  rel={isExternal ? 'noopener noreferrer' : undefined}
  aria-label={alt || text}
>
  {text}
</a>
